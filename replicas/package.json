{
  "name": "mini-raft-replica",
  "version": "3.0.0",
  "description": "Mini-RAFT replica node (persistent, linearizable, chaos-testable)",
  "main": "replicaServer.js",
  "scripts": {
    "start": "node replicaServer.js",
    "dev":   "nodemon replicaServer.js",
    "test":       "jest --runInBand --detectOpenHandles",
    "test:unit":  "jest tests/unit --runInBand",
    "test:int":   "jest tests/integration --runInBand --detectOpenHandles",
    "bench":      "node bench/bench.js --mode inprocess",
    "bench:http": "node bench/bench.js --mode http"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "testTimeout": 15000
  }
}